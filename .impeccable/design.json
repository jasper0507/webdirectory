      "html": "<label class=\"ds-search\"><span class=\"ds-search-icon\" aria-hidden=\"true\"></span><input class=\"ds-search-input\" type=\"search\" placeholder=\"搜索名称、地址、描述或分类\"></label>",
      "css": ".ds-search{position:relative;display:block}.ds-search-icon{position:absolute;left:0.95rem;top:50%;width:1.15rem;height:1.15rem;transform:translateY(-50%);border:1.75px solid #373734;border-radius:50%;box-sizing:border-box}.ds-search-input{width:100%;height:3.15rem;padding:0 1rem 0 2.7rem;background:#fff;color:#121212;border:1px solid #121212;border-radius:8px;font:400 1rem/1.5 \"Source Sans 3\",sans-serif}.ds-search-input::placeholder{color:#5c5b56;opacity:1}.ds-search-input:focus-visible{outline:2px solid #121212;outline-offset:3px}"
